
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FleetManager.ViewModels"
             xmlns:models="clr-namespace:FleetManager.Models"
             x:Class="FleetManager.Views.VehicleItemView"
             x:DataType="models:Vehicle">

    <StackPanel Spacing="5" Margin="8" >

        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>

        <TextBlock Text="{Binding LicensePlate}"/>

        <TextBlock Text="{Binding Status}"/>

        <TextBlock Text="{Binding FuelLevel, StringFormat='Paliwo: {0}%'}"/>

        <StackPanel Orientation="Horizontal" Spacing="5">

            <Button Content="Tankuj"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RefuelCommand}"
                    CommandParameter="{Binding}"
                    Width="120"
                    Height="50"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Margin="0 0 5 0"
                    Background="#AA9966"/>

            <Button Content="Do Serwisu"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SendToServiceCommand}"
                    CommandParameter="{Binding}"
                    Width="120"
                    Height="50"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Margin="0 0 5 0"
                    Background="#77AA99"/>
            
            <Button Content="Wyślij w trasę"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SendOnRoadCommand}"
                    CommandParameter="{Binding}"
                    Width="120"
                    Height="50"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Margin="0 0 5 0"
                    Background="RoyalBlue"
                    
                    />
            
            <Button Content="Wyślij do bazy"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SendBackCommand}"
                    CommandParameter="{Binding}"
                    Width="120"
                    Height="50"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Margin="0 0 5 0 "
                    Background="RosyBrown"
                    />
                    
                    

        </StackPanel>

    </StackPanel>

</UserControl>